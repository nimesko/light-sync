# Normalise line endings in the repository; Windows-only files keep CRLF on checkout.
* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.ps1 text eol=crlf
*.manifest text eol=crlf
*.ico binary
*.png binary
